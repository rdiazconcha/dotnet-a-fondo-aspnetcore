@page
@model FabuRobotics.WebApp.Pages.Accessories.IndexModel
@using FabuRobotics.WebApp.Models
@{
    ViewData["Title"] = "Catálogo de accesorios";
}

<h1>Catálogo de accesorios</h1>
<p class="lead">Accesorios, software y servicios para tu robot FabuRobotics.</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label asp-for="Search" class="form-label">Buscar</label>
        <input asp-for="Search" class="form-control" placeholder="Nombre, SKU o descripción" />
    </div>
    <div class="col-md-3">
        <label asp-for="Category" class="form-label">Categoría</label>
        <select asp-for="Category" class="form-select">
            <option value="">Todas</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Robot" class="form-label">Robot</label>
        <select asp-for="Robot" class="form-select">
            <option value="">Todos</option>
            <option value="FB-01">FB-01</option>
            <option value="FB-02">FB-02</option>
            <option value="FB-03">FB-03</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
        <a asp-page="/Accessories/Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p class="text-muted">Mostrando @Model.Accessories.Count de @Model.TotalCount accesorios.</p>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>SKU</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Compatible con</th>
            <th class="text-end">Precio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var accessory in Model.Accessories)
        {
            <tr>
                <td><code>@accessory.Sku</code></td>
                <td>
                    <div class="fw-semibold">@accessory.Name</div>
                    <small class="text-muted">@accessory.Description</small>
                </td>
                <td>@accessory.Category</td>
                <td>
                    @foreach (var robot in accessory.Compatibility)
                    {
                        <span class="badge bg-secondary">@robot</span>
                    }
                </td>
                <td class="text-end text-nowrap">@FormatPrice(accessory)</td>
            </tr>
        }
    </tbody>
</table>

@functions {
    private static string FormatPrice(Accessory accessory) => accessory.BillingPeriod switch
    {
        "mensual" => $"{accessory.PriceUsd:N2} USD / mes",
        "anual" => $"{accessory.PriceUsd:N2} USD / año",
        _ => $"{accessory.PriceUsd:N2} USD"
    };
}